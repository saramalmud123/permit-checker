# העתיקו קובץ זה ל-.env.local לפיתוח מקומי, ובענן הגדירו את אותם משתנים
# ישירות בלוח הבקרה של Vercel (Project Settings → Environment Variables).
#
# חשוב: אף אחד מהמשתנים כאן אינו אמור לקבל קידומת VITE_.
# קידומת VITE_ גורמת ל-Vite לארוז את הערך לתוך קוד הלקוח (הדפדפן),
# כלומר לחשוף אותו לכל מי שיפתח את "כלי הפיתוח" בדפדפן.
# המשתנים האלו נצרכים אך ורק ע"י middleware.js ו-api/extract.js (קוד שרת).

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

BASIC_AUTH_USER=inspector
BASIC_AUTH_PASS=change-me-strong-password
